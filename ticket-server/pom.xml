<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ticket</groupId>
        <artifactId>ticket-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    

    <groupId>com.ticket</groupId>
    <artifactId>ticket-server</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>ticket-server</name>
    <description>12306 式购票系统后端(单体起步,先纵后横,阶段五后拆微服务)</description>

    <properties>
        <java.version>17</java.version>
        <spring-cloud.version>2023.0.1</spring-cloud.version>
        <spring-cloud-alibaba.version>2023.0.1.0</spring-cloud-alibaba.version>
    </properties>

    <!--
      版本矩阵(三者必须配套,版本错配是 Spring Cloud 生态第一大坑):
        Spring Cloud Alibaba 2023.0.1.0 → Spring Cloud 2023.0.1 → Spring Boot 3.2.x
      两个 BOM 只做版本仲裁(dependencyManagement 不引入任何依赖),
      实际要用的组件在下面的 dependencies 里声明,版本由 BOM 决定
    -->
   

    <dependencies>
        <!-- Web:阶段二起的 REST 接口都基于它(内嵌 Tomcat) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 测试:JUnit5 + AssertJ + Mockito 全家桶 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Nacos 服务注册发现(版本由上面的 BOM 仲裁,无需手写 version) -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <!-- ORM:MyBatis-Plus(Boot3 专用 artifact,3.5.5 与 Boot 3.2 配套) -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>3.5.5</version>
        </dependency>
        <!-- MySQL 驱动(版本由 Boot BOM 管理) -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ticket</groupId>
            <artifactId>ticket-common</artifactId>
        </dependency>
        <!-- Feign:拆微服务后的服务间调用(调 train-service 的内部接口) -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <!-- Feign 按服务名解析必须的负载均衡器(否则 No Feign Client for loadBalancing) -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>

       
        <!-- Redis:阶段三多级缓存的中间层(默认客户端 Lettuce,基于 Netty 异步) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- Caffeine:本地缓存(第一级,纳秒级命中) -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <!-- RocketMQ:阶段五削峰(生产者发消息/消费者顺序消费) -->
        <dependency>
            <groupId>org.apache.rocketmq</groupId>
            <artifactId>rocketmq-spring-boot-starter</artifactId>
            <version>2.3.1</version>
        </dependency>
        <!--
          starter 2.3.1 无条件调用 setNamespaceV2,该方法只在 rocketmq-client 5.2.0+ 存在
          (starter 默认带的 5.1.4 会抛 NoSuchMethodError),显式钉 5.2.0。
        -->
        <dependency>
            <groupId>org.apache.rocketmq</groupId>
            <artifactId>rocketmq-client</artifactId>
            <version>5.2.0</version>
        </dependency>
        <!-- ShardingSphere JDBC:JDBC Driver 模式(与 Boot 版本解耦),配置独立 sharding.yaml
             5.5.0(镜像仅有此版本);排除 test-util(打包瑕疵,运行不需要);算法用 INLINE 避开 MOD 自动归类坑 -->
        <dependency>
            <groupId>org.apache.shardingsphere</groupId>
            <artifactId>shardingsphere-jdbc</artifactId>
            <version>5.5.0</version>
            <exclusions>
                <exclusion>
                    <groupId>org.apache.shardingsphere</groupId>
                    <artifactId>shardingsphere-test-util</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
